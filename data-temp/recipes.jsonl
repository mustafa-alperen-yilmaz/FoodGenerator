{"id":"r1","title":"Menemen","servings":1,"image":"","ingredients":[{"name":"yumurta","qty":2,"unit":"adet"},{"name":"domates","qty":2,"unit":"adet"},{"name":"soğan","qty":0.5,"unit":"adet"},{"name":"zeytinyağı","qty":1,"unit":"yemek kaşığı"},{"name":"tuz","qty":0.5,"unit":"çay kaşığı"}],"steps":["Soğanı doğrayıp yağda 2-3 dk sotele.","Domatesi ekleyip suyunu biraz çektir.","Çırpılmış yumurtayı ekleyip karıştır; tuzla bitir."]}
